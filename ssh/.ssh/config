# ~/.ssh/config
#
# Personal host aliases (real hostnames, usernames, which key for which
# remote) are infrastructure info that shouldn't sit in a public repo, so
# they go in ~/.ssh/config.local instead — see config.local.example for the
# pattern. Same shape as zsh/secrets.zsh.example: a gitignored local file
# (the repo's *.local glob already covers it) that this file pulls in.
#
# Included first so its Host blocks take priority — ssh config is
# first-match-wins per setting, so local overrides need to come before the
# catch-all defaults below.
Include ~/.ssh/config.local

# ─── Defaults for every host ────────────────────────────────────────────────
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Reuse one connection per host instead of renegotiating on every ssh —
  # noticeably faster for repeated connections (git over ssh, scp, etc.).
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m
