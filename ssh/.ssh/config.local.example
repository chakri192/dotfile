# Template for ~/.ssh/config.local — copy, fill in with real hosts.
# The real file is never committed; see the repo's *.local .gitignore glob.
#
#   cp ssh/.ssh/config.local.example ~/.ssh/config.local
#
# ~/.ssh/config sources this first, so entries here take priority over the
# `Host *` defaults there.

# Host example-server
#   HostName 203.0.113.10
#   User deploy
#   Port 22
#   IdentityFile ~/.ssh/id_ed25519

# Host github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519
