#!/usr/bin/env zsh
#
# send-to-ollama
#
# Summarizes one or more text files via local Ollama.
# Writes each summary to <name>-summary.md next to the original.
#
# Usage:
#   send-to-ollama file1.md file2.txt ...
#   OLLAMA_MODEL=qwen2.5:7b send-to-ollama file.md   # override the model
#
# Wired as the "Send to Ollama" Finder Quick Action — see services/README.md.

set -uo pipefail

MODEL="${OLLAMA_MODEL:-llama3.1:8b}"

# Resolve binaries from PATH first (works for brew on Apple Silicon,
# /usr/local, or the Ollama.app), falling back to common install paths.
OLLAMA="$(command -v ollama || true)"
[ -z "$OLLAMA" ] && for p in /opt/homebrew/bin/ollama /usr/local/bin/ollama; do
  [ -x "$p" ] && OLLAMA="$p" && break
done
BAT="$(command -v bat || true)"

if [ -z "$OLLAMA" ] || [ ! -x "$OLLAMA" ]; then
  osascript -e 'display notification "ollama not found on PATH" with title "Send to Ollama"'
  exit 1
fi

for f in "$@"; do
  [ -f "$f" ] || continue

  dir=$(dirname "$f")
  base=$(basename "$f")
  name="${base%.*}"
  out="$dir/${name}-summary.md"

  if [ -n "$BAT" ]; then
    content=$("$BAT" --style=plain --paging=never "$f" 2>/dev/null) || content=$(<"$f")
  else
    content=$(<"$f")
  fi

  prompt="Summarize the following document concisely, preserving key points and structure. Output only the summary, no preamble:

$content"

  # Pipe the prompt via stdin, not as a CLI argument: large documents would
  # otherwise blow past ARG_MAX and fail with "argument list too long".
  summary=$(printf '%s' "$prompt" | "$OLLAMA" run "$MODEL" 2>/dev/null)

  if [ -z "$summary" ]; then
    osascript -e "display notification \"Failed: $base\" with title \"Send to Ollama\""
    continue
  fi

  print -r -- "$summary" > "$out"
  osascript -e "display notification \"Saved $(basename "$out")\" with title \"Send to Ollama\""
done
