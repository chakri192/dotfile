#!/bin/zsh
#
# repo-sync
#
# Checks every git repo one level deep inside a base folder (default:
# ~/Documents/portfolio) against its remote, and pulls any that are behind.
# Repos that are ahead or have diverged are left alone and flagged, since
# those need a deliberate push or manual merge rather than an automatic pull.
#
# Usage:
#   repo-sync                # scan ~/Documents/portfolio
#   repo-sync ~/dev          # scan a different base folder

BASE="${1:-$HOME/Documents/portfolio}"

if [[ ! -d "$BASE" ]]; then
    echo "repo-sync: '$BASE' is not a directory" >&2
    exit 1
fi

cd "$BASE" || exit 1

for dir in */; do
    [[ -e "$dir/.git" ]] || continue

    echo "=== ${dir%/} ==="
    (
        cd "$dir" || exit 1
        git fetch origin --quiet

        # Skip repos with no configured upstream for the current branch.
        if ! upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null); then
            echo "  no upstream tracking branch — skipping"
            exit 0
        fi

        # Precise ahead/behind counts relative to the upstream.
        counts=$(git rev-list --left-right --count "@{u}...HEAD" 2>/dev/null) || {
            echo "  could not compare with $upstream — skipping"
            exit 0
        }
        behind=${counts%%[[:space:]]*}
        ahead=${counts##*[[:space:]]}

        if (( behind > 0 && ahead > 0 )); then
            echo "  diverged ($ahead ahead, $behind behind) — needs manual merge, skipping"
        elif (( behind > 0 )); then
            echo "  behind by $behind — pulling..."
            git pull --ff-only
        elif (( ahead > 0 )); then
            echo "  ahead of $upstream by $ahead — not pulling (push instead)"
        else
            echo "  up to date"
        fi
    )
done
