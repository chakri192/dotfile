# Template for ~/.secrets.zsh — copy, fill in, chmod 600.
# The real file is never committed; see .gitignore.
#
#   cp zsh/secrets.zsh.example ~/.secrets.zsh && chmod 600 ~/.secrets.zsh
#
# .zshrc sources it if present, so a machine without it still starts cleanly.

export GEMINI_API_KEY=""
export GROQ_API_KEY=""
export AI_PROVIDER="groq"
