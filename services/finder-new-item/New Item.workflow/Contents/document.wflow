				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	tell application "Finder"
		try
			set targetFolder to folder of the front window
		on error
			set targetFolder to desktop
		end try
		set folderPath to (targetFolder as alias) as string
	end tell
	set itemTypes to {"Folder", "Text Document (.txt)", "Markdown (.md)", "Rich Text (.rtf)", "HTML (.html)", "Shell Script (.sh)", "Python Script (.py)", "JavaScript (.js)", "JSON (.json)", "C Source (.c)"}
	set chosen to choose from list itemTypes with prompt "Create New:" with title "New Item" default items {"Folder"}
	if chosen is false then return
	set choice to item 1 of chosen
	set baseName to "New Item"
	set theExt to ""
	set isFolder to false
	if choice is "Folder" then
		set baseName to "New Folder"
		set isFolder to true
	else if choice is "Text Document (.txt)" then
		set baseName to "New Text Document"
		set theExt to ".txt"
	else if choice is "Markdown (.md)" then
		set baseName to "New Markdown File"
		set theExt to ".md"
	else if choice is "Rich Text (.rtf)" then
		set baseName to "New Rich Text Document"
		set theExt to ".rtf"
	else if choice is "HTML (.html)" then
		set baseName to "New HTML File"
		set theExt to ".html"
	else if choice is "Shell Script (.sh)" then
		set baseName to "New Shell Script"
		set theExt to ".sh"
	else if choice is "Python Script (.py)" then
		set baseName to "New Python Script"
		set theExt to ".py"
	else if choice is "JavaScript (.js)" then
		set baseName to "New JavaScript File"
		set theExt to ".js"
	else if choice is "JSON (.json)" then
		set baseName to "New JSON File"
		set theExt to ".json"
	else if choice is "C Source (.c)" then
		set baseName to "New C Source"
		set theExt to ".c"
	end if
	set finalName to baseName &amp; theExt
	set counter to 2
	tell application "Finder"
		repeat while exists item (folderPath &amp; finalName)
			set finalName to baseName &amp; " " &amp; counter &amp; theExt
			set counter to counter + 1
		end repeat
		activate
		if isFolder then
			set newItem to make new folder at targetFolder with properties {name:finalName}
		else
			set newItem to make new file at targetFolder with properties {name:finalName}
		end if
		set selection to {newItem}
		reveal newItem
	end tell
	delay 0.3
	tell application "System Events"
		tell process "Finder"
			keystroke return
		end tell
	end tell
end run</string>
				</dict>
