{
  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       PERFORMANCE & CORE
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "editor.accessibilitySupport": "off",
  "telemetry.telemetryLevel": "off",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": true,
  "editor.minimap.enabled": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.renderWhitespace": "selection",
  "extensions.autoUpdate": false,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       TYPOGRAPHY, CURSOR & HINTS
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "editor.fontFamily": "JetBrains Mono, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 13.5,
  "editor.lineHeight": 1.8,
  "editor.cursorBlinking": "expand",
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.fontSize": 11,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       FILE MANAGEMENT & NESTING
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.c": "${capture}.h, ${capture}.o, ${capture}.out",
    "*.cpp": "${capture}.hpp, ${capture}.h, ${capture}.o, ${capture}.out",
    "*.h": "${capture}.c, ${capture}.cpp",
    "*.py": "${capture}.pyi, __pycache__",
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
    "*.js": "${capture}.js.map, ${capture}.min.js",
    "package.json": "package-lock.json, bun.lockb, yarn.lock, .eslintrc*, next.config*, tailwind.config*, tsconfig*",
    "*.sqlite": "${capture}.sqlite-shm, ${capture}.sqlite-wal",
    ".env": ".env.example, .env.local, .env.development, .env.production",
    "Dockerfile": ".dockerignore, docker-compose*.yml",
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/*.dSYM": true,
  },
  "files.autoSave": "onFocusChange",
  "files.hotExit": "onExitAndWindowClose",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       QUALITY OF LIFE (QoL)
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 10,
  "editor.inlineSuggest.enabled": true,
  "editor.wordWrap": "off",
  "editor.rulers": [88, 120],
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": true,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.snippetSuggestions": "top",
  "editor.tabCompletion": "on",
  "editor.suggest.preview": true,
  "editor.suggest.showMethods": true,
  "editor.suggest.showFunctions": true,
  "editor.hover.delay": 500,
  "editor.hover.sticky": true,
  "editor.find.addExtraSpaceOnTop": false,
  "editor.dragAndDrop": false,
  "editor.copyWithSyntaxHighlighting": false,
  "problems.decorations.enabled": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.activityBar.location": "top",
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "last",
  "breadcrumbs.symbolPath": "last",
  "editor.suggestSelection": "first",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#ffffff15",
    "editorIndentGuide.background1": "#303030",
    "editorIndentGuide.activeBackground1": "#006666",
    "editorBracketGuide.activeBackground1": "#006666",
    "editorBracketGuide.activeBackground2": "#006666",
    "editorBracketGuide.activeBackground3": "#006666",
    "editorBracketGuide.background1": "#303030",
    "editorBracketGuide.background2": "#303030",
    "editorBracketGuide.background3": "#303030",
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "punctuation.definition.bracket",
        "settings": { "foreground": "#606060" },
      },
    ],
  },

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       SEARCH
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/.git": true,
  },
  "search.useIgnoreFiles": true,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       TERMINAL
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "terminal.integrated.fontFamily": "JetBrains Mono, MesloLGS NF, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.macOptionClickModifiers": "control",

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       DIFF & MERGE
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       LANGUAGE-SPECIFIC OVERRIDES
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit",
    },
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
  },
  "[json][jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "python.defaultInterpreterPath": "/opt/miniconda3/bin/python3",
  "python.condaPath": "/opt/miniconda3/bin/conda",
  "python.createEnvironment.trigger": "off",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       C / C++ & BINARY
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "C_Cpp.inlayHints.parameterNames.enabled": true,
  "C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
  "C_Cpp.errorSquiggles": "enabled",
  "workbench.editorAssociations": {
    "*.bin": "hexEditor.hexedit",
    "*.hex": "hexEditor.hexedit",
    "*.exe": "hexEditor.hexedit",
    "*.o": "hexEditor.hexedit",
  },
  "workbench.editor.defaultBinaryEditor": "hexEditor.hexedit",

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       GIT & VERSION CONTROL
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "scm.diffDecorations": "all",
  "scm.diffDecorationsGutterWidth": 2,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "google:gemini-3.0-pro",
  "gitlens.experimental.generateCommitMessagePrompt": "Generate a concise, professional commit message based on these changes.",

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       AI & MODERN TOOLS
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "claudeCode.preferredLocation": "panel",
  "geminicodeassist.project": "sacred-alloy-bsdxz",
  "google.gemini.codeAssist.inlineSuggestions.enabled": true,
  "google.gemini.codeAssist.nextEditPredictions.enabled": true,
  "google.gemini.telemetry.enabled": false,
  "google.gemini.recitation.maxCitedLength": 0,
  "google.gemini.chat.sidePanelLocation": "right",
  "geminicodeassist.inlineSuggestions.enableAuto": true,
  "continue.enableAutocomplete": false,
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.preserveFocus": true,
  "code-runner.saveFileBeforeRun": true,

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       INFRASTRUCTURE & SCHEMAS
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  "http.systemCertificatesNode": true,
  "yaml.schemas": {
    "file:///Users/chakri/.vscode/extensions/continue.continue-1.2.22-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "diffEditor.codeLens": true,
  // "vscode-kubernetes.helm-path-mac": "/path/to/helm",
  // "vscode-kubernetes.minikube-path-mac": "/path/to/minikube",
}
